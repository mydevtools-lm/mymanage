{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "management-spike",
  "version": "0.1.0",
  "identifier": "io.github.mydevtools-lm.management",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:desktop-web",
    "beforeBuildCommand": "npm run build:desktop-web"
  },
  "app": {
    "windows": [
      {
        "title": "ניהול אישי",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
