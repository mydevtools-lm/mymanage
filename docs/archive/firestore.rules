rules_version = '2';

// Everything lives under users/{uid}/…, and only one account may read or
// write it. Replace OWNER_UID with your uid after the first sign-in
// (Firebase console › Authentication › Users). See docs/FIREBASE.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && uid == "OWNER_UID";
    }
    // Anything else: closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
