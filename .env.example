# העתק את הקובץ הזה ל-.env.local ומלא את הערך.
# .env.local לא נכנס ל-git (ראה .gitignore).

# כתובת ה-iCal הפרטית של גוגל יומן — קריאה בלבד.
#
# איך משיגים אותה:
#   1. פותחים את https://calendar.google.com במחשב
#   2. בעמודה השמאלית, מרחפים על שם היומן → שלוש נקודות → "הגדרות ושיתוף"
#   3. גוללים ל-"שילוב יומן"
#   4. מעתיקים את "כתובת סודית בפורמט iCal" (Secret address in iCal format)
#
# הכתובת נראית כך:
#   https://calendar.google.com/calendar/ical/xxxxx%40group.calendar.google.com/private-yyyyy/basic.ics
#
# אזהרה: הכתובת הזו היא סיסמה לכל דבר — כל מי שמחזיק בה רואה את כל היומן.
# אל תשתף אותה ואל תכניס אותה לקומיט. אם דלפה — באותו מסך יש "אפס" (Reset)
# שמבטל את הישנה ומייצר חדשה.
#
# אחרי הדבקה צריך להפעיל מחדש את שרת הפיתוח (Ctrl+C ואז npm run dev).

GOOGLE_CALENDAR_ICS_URL=

# שם לתצוגה ליומן הראשון (רשות). ברירת המחדל: "גוגל יומן".
GOOGLE_CALENDAR_NAME=

# יומנים נוספים (רשות) — עד 9. אותה כתובת סודית מכל יומן, עם מספר:
#   GOOGLE_CALENDAR_ICS_URL_2=https://calendar.google.com/calendar/ical/.../basic.ics
#   GOOGLE_CALENDAR_NAME_2=עבודה
# צבע והסתרה לכל יומן — בהגדרות › חיבורים.
